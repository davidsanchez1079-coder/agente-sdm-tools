# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://jfaduglaksfvrnmyswzx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_iqFVzr2EgC6G476Fi9VAzQ_MBUdOH05
# Requerida para el webhook de correo de notificaciones (solo servidor).
SUPABASE_SERVICE_ROLE_KEY=

# AI providers
# ANTHROPIC_API_KEY es requerido para el agente IA v1.
# Obtenla en https://console.anthropic.com/ y pégala aquí en local.
# En Vercel: Project Settings -> Environment Variables (Production + Preview).
ANTHROPIC_API_KEY=
# Opcional. Default del código: claude-sonnet-4-6.
ANTHROPIC_MODEL=
OPENAI_API_KEY=

# Email — Resend para invitaciones del módulo Accesos
# Crea cuenta en resend.com, genera API key, verifica el dominio
# (sadama.com.mx) con SPF + DKIM antes de mandar a producción.
RESEND_API_KEY=
RESEND_FROM_EMAIL=invitaciongotia@sadama.com.mx
RESEND_FROM_NAME=GOTIA

# App
NEXT_PUBLIC_APP_NAME=GOTIA
NEXT_PUBLIC_APP_ENV=staging
# URL base usada en el link de invitación dentro del correo. En prod
# debe ser el dominio público del deploy (ej. https://agente-sdm-tools.vercel.app
# o el dominio custom). Si está vacío la API la deriva del request.
NEXT_PUBLIC_APP_URL=

# Webhook Database → POST /api/webhooks/notification-email (Supabase Dashboard).
# Mismo valor en header `x-gotia-webhook-secret` del webhook y aquí.
NOTIFICATION_EMAIL_WEBHOOK_SECRET=
